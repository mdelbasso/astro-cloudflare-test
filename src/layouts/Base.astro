---
import '../styles/global.css';
import { ui, site, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** ruta sin idioma: '' (portada) o '404' */
  path: '' | '404';
  noindex?: boolean;
}
const { lang, title, description, path, noindex = false } = Astro.props;

const urlEs = `${site}/${path}`;
const urlEn = `${site}/en/${path}`;
const canonical = lang === 'es' ? urlEs : urlEn;

// Pesos recortados a los que realmente usa el CSS: Archivo 700/800/900, Newsreader 400 normal+itálica, Space Mono 400/700.
const fonts =
  'https://fonts.googleapis.com/css2?family=Archivo:wght@700;800;900&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Space+Mono:wght@400;700&display=swap';
---
<!doctype html>
<html lang={ui[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="es" href={urlEs} />
    <link rel="alternate" hreflang="x-default" href={urlEs} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    {/* La fuente no bloquea el render: preload + swap (media="print" → "all" al cargar). */}
    <link rel="preload" as="style" href={fonts} />
    <link href={fonts} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href={fonts} rel="stylesheet" /></noscript>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
