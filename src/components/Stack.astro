---
import { ui, stackGroups, type Lang } from '../i18n/ui';
import DeckNote from './DeckNote.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang].stack;
---
<!-- STACK / APPENDIX -->
<section class="sec" id="stack">
  <div class="wrap">
    <p class="doc-tag fade"><b>{t.doctag}</b> — <span>{t.doctag2}</span></p>
    <div class="sec-head" style="padding-top:28px;">
      <h2>{t.title}</h2>
      <DeckNote text={t.deck} />
    </div>
    <div class="stack-grid stag">
      {stackGroups.map((g) => (
        <div class="stack-col"><h3>{g.h}</h3><ul>{g.items.map((i) => <li>{i}</li>)}</ul></div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* ============ STACK (apéndice) ============ */
  .stack-grid{display:grid;grid-template-columns:1fr;gap:0;border-bottom:1px solid var(--ink-15);margin-bottom:96px;}
  @media(min-width:680px){.stack-grid{grid-template-columns:repeat(2,1fr);}}
  @media(min-width:1000px){.stack-grid{grid-template-columns:repeat(3,1fr);}}
  .stack-col{padding:28px 0;border-top:1px solid var(--ink-15);}
  @media(min-width:680px){.stack-col{padding:30px 34px 30px 0;}}
  .stack-col h3{font-family:var(--mono);font-weight:700;font-size:var(--fs-2xs);letter-spacing:0.08em;text-transform:uppercase;color:var(--accent-deep);margin-bottom:16px;}
  .stack-col ul{display:flex;flex-wrap:wrap;gap:6px 14px;}
  .stack-col li{font-family:var(--mono);font-size:var(--fs-xs);color:var(--ink-70);letter-spacing:0.01em;transition:color .18s ease;}
  @media (hover:hover) and (pointer:fine){ .stack-col li:hover{color:var(--accent);} }
</style>
