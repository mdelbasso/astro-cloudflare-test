---
interface Props { items: readonly string[]; }
const { items } = Astro.props;
---
<div class="chipset">{items.map((c) => <span class="chip">{c}</span>)}</div>

<style is:global>
  .chipset{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px;}
  .chip{font-family:var(--mono);font-size:var(--fs-2xs);letter-spacing:0.03em;color:var(--ink-70);border:1px solid var(--ink-15);padding:5px 10px;}
</style>
